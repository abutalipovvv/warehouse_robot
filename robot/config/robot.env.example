# Copy to /etc/warehouse-robot/robot.env during robot provisioning.
# These values are permanent for one physical robot.
ROBOT_ID=warehouse-r01
ROS_NAMESPACE=warehouse_r01
ROS_DOMAIN_ID=31
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///etc/warehouse-robot/cyclonedds.xml
WAREHOUSE_REQUIRE_IDENTITY=true
