include "trp1.inc"



define floorplan model
(
  # sombre, sensible, artistic
  color "gray30"

  # most maps will need a bounding box
  boundary 1

  gui_nose 0
  gui_move 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

resolution 0.05
interval_sim 100  # simulation timestep in milliseconds

window
(
  size [ 635.000 666.000 ] # in pixels
  scale 36.995   # pixels per meter
  center [ -0.040  -0.274 ]
  rotate [ 0  0 ]

  show_data 1              # 1=on 0=off
)

floorplan
(
  name "id19_map"
  bitmap "bitmaps/id19_map.pgm"
#  size [ 41.600 20.000 2.000 ]
  size [ 225.000 137.500 2.000 ]
  pose [  0.000  0.000 0.000 0.000 ]
)

define cube model
(
  size [0.500 0.500 0.500]
  gui_nose 0
)

define odom_calib model
(
  size [0.200 0.200 0.500]
  gui_nose 0
)


define dock model
(
	size [0.071 0.441 0.500]
	block
        (
         points 4
         point[0] [0 0]
	 point[1] [0.0707 0.0707]
	 point[2] [0.0707 0.3707]
	 point[3] [0 0.4414]
         z [0 1]
        )
)

define dock3 model
(
	size [0.071 0.441 0.500]
	block
        (
         points 7
            point[0] [0 0.0707]
