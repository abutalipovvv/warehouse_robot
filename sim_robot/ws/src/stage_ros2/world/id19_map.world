#adding blocks
cube( pose [ 2.000 4.000 0.000 0.000 ] color "green")
odom_calib( pose [ 3.000 5.000 0.000 0.000 ] color "blue")

#holder3( pose [ -6.500 -0.30 0.000 0.000 ] color "blue")
dock4( pose [ -1.31 -4.1800 0.000 -1.18 ] color "yellow")

# throw in a robot
trp1
(
  pose [ -8.0 37.0 0.000 100.0 ]
  name "trp1"
)
