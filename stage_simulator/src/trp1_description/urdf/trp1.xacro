<?xml version="1.0"?>
<!-- Revolute-Revolute Manipulator -->
<robot name="trp1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Constants for robot dimensions -->
  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find trp1_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find trp1_description)/urdf/d430.urdf.xacro"/>

  <!-- Base Link -->
  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.115" rpy="0 0 0"/>
      <geometry>
        <box size=".6 .5 .01"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <box size=".58 .22 .3"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <geometry>
        <box size=".38 .42 .3"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz=".19 .11 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.1"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="-0.19 -0.11 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.1"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="0.19 -0.11 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.1"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="-0.19 0.11 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.1"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="0.20 0 0.225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.31" radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision name="collision_f">
      <origin xyz="-0.250 0.0 0.05" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.03" radius="0.04625"/>
      </geometry>
    </collision>

    <visual name="visual_front_wheel_stub">
      <origin xyz="-0.250 0.0 0.05" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.03" radius="0.04625"/>
      </geometry>
    </visual>

    <collision name="collision_b">
      <origin xyz="0.250 0.0 0.05" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.03" radius="0.04625"/>
      </geometry>
    </collision>

    <visual name="visual_back_wheel_stub">
      <origin xyz="0.250 0.0 0.05" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.03" radius="0.04625"/>
      </geometry>
    </visual>

    <!--
    <inertial>
       <mass value="20" />
       <origin xyz="-0.08 0 0" rpy="0 0 0"/>
       <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
    </inertial>
    -->
  </link>

  <!-- Intel D430 -->
  <joint type="fixed" name="camera_joint">
    <origin xyz="0.34 0.0 0.08" rpy="0 -0.13 0"/>
    <child link="camera_mount_link">camera_mount_link</child>
    <parent link="base_link">base_link</parent>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- Intel D430 End -->

  <link name="left_wheel">
    <collision name="collision">
      <origin xyz="0 0.0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.05" radius="0.0605"/>
      </geometry>
    </collision>

    <visual name="visual">
      <origin xyz="0 0.0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.05" radius="0.0605"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="1" />
      <origin xyz="0 0.0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
  </link>

  <joint type="fixed" name="left_wheel_hinge">
    <origin xyz="0 0.18 0.0605" rpy="0 0 0"/>
    <child link="left_wheel">left_wheel</child>
    <parent link="base_link">base_link</parent>
  </joint>

  <link name="right_wheel">
    <collision name="collision">
      <origin xyz="0 0.0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.05" radius="0.0605"/>
      </geometry>
    </collision>

    <visual name="visual">
      <origin xyz="0 0.0 0" rpy="0 1.5707 1.5707"/>
      <geometry>
        <cylinder length="0.05" radius="0.0605"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="1" />
      <origin xyz="0 0.0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
  </link>

  <joint type="fixed" name="right_wheel_hinge">
    <origin xyz="0 -0.18 0.0605" rpy="0 0 0"/>
    <child link="right_wheel">right_wheel</child>
    <parent link="base_link">base_link</parent>
  </joint>

  <transmission name="tran1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_wheel_hinge">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_motor">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="tran2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wheel_hinge">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_motor">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
</robot>